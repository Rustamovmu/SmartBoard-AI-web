NEXT_PUBLIC_WEB_ORIGIN=https://localhost:3000
NEXT_PUBLIC_AUTH_API_ORIGIN=https://localhost:4000
# Absolute paths to your own locally trusted certificate/key. Never commit keys.
WEB_TLS_CERT=/absolute/path/localhost.pem
WEB_TLS_KEY=/absolute/path/localhost-key.pem
NODE_EXTRA_CA_CERTS=/absolute/path/local-root-ca.pem
